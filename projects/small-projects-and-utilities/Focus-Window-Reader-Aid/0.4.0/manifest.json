{
  "manifest_version": 3,
  "name": "Focus Window Reader Aid",
  "version": "0.4.0",
  "description": "Assistive reading focus overlay for Firefox. Version 0.4.0 clean-rewrite persistence prototype.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Toggle Focus Window Reader Aid"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}