NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SITE_BASE_PATH=/wedding

GOOGLE_SPREADSHEET_ID=

# Google API authentication uses Application Default Credentials (ADC).
# Local development: authenticate with Google Cloud CLI user credentials.
# Production: configure Workload Identity Federation and point
# GOOGLE_APPLICATION_CREDENTIALS to its generated credential configuration.

RSVP_DEADLINE=2027-03-01T23:59:00-05:00
RSVP_TIME_ZONE=America/New_York

# Production RSVP email delivery uses Resend.
# Keep the protected administrative recipient and RESEND_API_KEY only in
# backend secret configuration; never commit their real values.
RSVP_ADMIN_NOTIFICATION_EMAIL=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RSVP_FROM_NAME=Norstein-Dashiell Wedding
RSVP_FROM_EMAIL=confirm@rsvp.loreweavercreations.com
RSVP_REPLY_TO_EMAIL=RSVPhelp@loreweavercreations.com

# The isolated Resend live test receives its test recipient and explicit
# acknowledgement ephemerally from the shell. Do not persist them here.
#
# Manual RSVP confirmation resend likewise receives the invitation code and
# explicit acknowledgement ephemerally from the maintenance shell. Do not
# persist RSVP_MANUAL_RESEND_INVITE_CODE or RSVP_MANUAL_RESEND_ACK here.

SMS_PROVIDER=
RSVP_SMS_ENABLED=false

ALLOWED_ORIGIN=

# Production only: identify the bounded reverse-proxy chain used before Express.
# A numeric value is the trusted hop count (for example, 1 when Express is
# reachable only through exactly one approved proxy). Exact proxy/CIDR entries
# may also be supplied as a comma-separated list. Never use true or *.
TRUST_PROXY=


# Private maintenance-only production invitation transformation input.
# Use an ignored local .json row export or CSV export of the Invitees List tab.
# Do not commit the source file or generated production invitation records.
RSVP_PRODUCTION_SOURCE_FILE=

# Optional private pre-load RSVP-store snapshot directory. When omitted, the
# production invitation loader uses the ignored private-working-materials/
# rsvp-backups directory. Never point this at a public or source-controlled path.
RSVP_PRODUCTION_BACKUP_DIR=

# RSVP_PRODUCTION_ACTIVATION_ACK is an ephemeral destructive-write acknowledgement
# and must not be persisted here. Supply it only for the guarded production load.
